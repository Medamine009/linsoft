        <!-- ══════════ NOTE DE LECTURE ══════════ -->
        <mxCell id="note" value="Les associations sont LOGIQUES : chaque microservice possède sa propre base,&#10;il n'existe aucune clé étrangère entre elles. Les liens se font par identifiant&#10;(keycloakId, eventId, registrationId) et certaines données sont volontairement&#10;dupliquées (Registration.eventTitle, attendeeName) pour éviter une jointure&#10;inter-services à chaque lecture." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="240" width="290" height="120" as="geometry"/></mxCell>

