<mxfile host="app.diagrams.net">
  <diagram name="Cas d'utilisation" id="usecaseauth">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Frontiere du systeme -->
        <mxCell id="sys" value="LINSOFT Learning Center" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="610" height="960" as="geometry"/></mxCell>

        <!-- Acteurs -->
        <mxCell id="PART" value="Participant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="ORG" value="Organisateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="ADM" value="Administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="40" height="80" as="geometry"/></mxCell>

        <!-- Cas d'authentification (inclus par tous) -->
        <mxCell id="AUTH" value="S'authentifier" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="462" width="210" height="66" as="geometry"/></mxCell>

        <!-- Cas Participant (vert) -->
        <mxCell id="PC" value="Gérer son profil" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="P1" value="Consulter le catalogue" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="P2" value="Demander une inscription" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="P3" value="Consulter mes inscriptions" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="P4" value="Télécharger son certificat" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="320" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="P5" value="Publier un avis" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="380" width="240" height="42" as="geometry"/></mxCell>

        <!-- Cas Organisateur (orange) -->
        <mxCell id="O1" value="Créer une session" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="460" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="O2" value="Gérer ses sessions" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="O3" value="Consulter ses statistiques" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="580" width="240" height="42" as="geometry"/></mxCell>

        <!-- Cas Administrateur (rouge) -->
