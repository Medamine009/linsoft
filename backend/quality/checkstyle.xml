<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Règles Checkstyle — LINSOFT Learning Center.

  Volontairement ciblées sur ce qui révèle de vrais défauts (ressources non
  fermées, égalité mal écrite, `catch` vide, imports morts) plutôt que sur la
  mise en forme. Un ruleset trop bavard finit désactivé : ici, ce qui est
  signalé en `error` mérite réellement une correction.

  Sévérités :
    error   -> à corriger (fait échouer la CI si -Dcheckstyle.failOnViolation=true)
    warning -> signalé, non bloquant
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Encodage homogène : le projet contient beaucoup de texte accentué. -->
    <property name="charset" value="UTF-8"/>

    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^\s*(\*|//).*$"/>
        <property name="severity" value="warning"/>
    </module>

    <module name="TreeWalker">

        <!-- ─── Défauts réels ─── -->

        <!-- `==` sur des chaînes : source classique de bugs silencieux. -->
        <module name="StringLiteralEquality">
            <property name="severity" value="error"/>
        </module>

        <!-- equals() sans hashCode() : casse les collections. -->
        <module name="EqualsHashCode">
            <property name="severity" value="error"/>
        </module>

        <!-- Un catch totalement vide masque les pannes en production.
             Le projet en utilise volontairement quelques-uns (enrichissement
             best-effort) : ils doivent être commentés, d'où l'exemption. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
            <property name="commentFormat" value=".*"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Affectation à l'intérieur d'une expression. -->
        <module name="InnerAssignment">
            <property name="severity" value="error"/>
        </module>

        <!-- if/else/while sans accolades : piège du `goto fail`. -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- `switch` sans default. -->
        <module name="MissingSwitchDefault">
            <property name="severity" value="warning"/>
        </module>

        <!-- Chaînage de `case` sans break volontaire. -->
        <module name="FallThrough">
            <property name="severity" value="error"/>
        </module>

        <!-- ─── Hygiène ─── -->

        <module name="UnusedImports">
            <property name="severity" value="warning"/>
        </module>
        <module name="RedundantImport">
            <property name="severity" value="warning"/>
        </module>
        <module name="IllegalImport">
            <property name="severity" value="error"/>
        </module>

        <!-- Champs publics mutables hors constantes. -->
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="true"/>
            <property name="packageAllowed" value="true"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- ─── Nommage (conventions Java standard) ─── -->

        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
            <property name="severity" value="warning"/>
        </module>
        <module name="TypeName">
            <property name="severity" value="warning"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
            <property name="severity" value="warning"/>
        </module>
        <module name="ConstantName">
            <property name="severity" value="warning"/>
        </module>

        <!-- ─── Complexité ─── -->

        <!-- Signale les méthodes devenues trop touffues pour être testées
             sérieusement. Seuil large : on vise les cas extrêmes. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="20"/>
            <property name="severity" value="warning"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="200"/>
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
