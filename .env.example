# ============================================================
# Modèle de configuration locale — LINSOFT Learning Center
#
#   cp .env.example .env      puis renseigner les valeurs réelles.
#
# `.env` est ignoré par Git : aucune valeur réelle ne doit être versionnée.
# docker compose lit ce fichier automatiquement.
# ============================================================

# ─── Assistant IA (ai-service) ───
# Clé API Google Gemini — https://aistudio.google.com/apikey
# Sans clé, l'ai-service démarre mais le chatbot et l'analyse des avis
# renvoient une erreur explicite : le reste de la plateforme fonctionne.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── PostgreSQL (user-service) ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=user_db

# ─── RabbitMQ ───
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me

# ─── Keycloak (console d'administration) ───
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
